# Docker image to pull (override if self-hosting under a different name)
SYNCCIT_IMAGE=ghcr.io/thinkaliker/synccit:latest
COMPOSE_PROFILES=internal-db

# Port to expose on the host
APP_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
# For bundled DB (--profile internal-db), these are used for both the MySQL
# container and the app. For an external DB, point DB_HOST at your server.
DB_HOST=synccit_db
DB_USER=synccit
DB_PASS=synccit
DB_NAME=rddtsync

# Root password only used by the bundled MySQL container
MYSQL_ROOT_PASSWORD=changeme

# ── Application ─────────────────────────────────────────────────────────────
# Public-facing host, no trailing slash
BASE_HOST=http://localhost:8080

# Subpath if not serving from /  (e.g. /synccit). Leave blank for root.
BASE_URL=

# Override API location if different from BASE_HOST/api/
API_LOC=

# Enable mod_rewrite pretty URLs (true/false)
PRETTY_URLS=true

# Set to true to also initialize the optional apps table on first start
INIT_APPS_DB=false

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Comma separated IPs/CIDRs that are allowed to set X-Forwarded-For. Set this
# when synccit sits behind Caddy/nginx/Cloudflare, otherwise every request is
# logged as coming from the proxy and an IP-based ban would hit the proxy
# itself. Leave empty if synccit is reached directly — an unset value means
# X-Forwarded-For is ignored, which is the safe default.
# For a proxy running in a docker network, the whole private range is usual:
#TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# ── SMTP (for password reset emails) ────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_ENC=ssl
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
